module Config {
    const USE_DEMO_DATA = false;

    const API_URL =
        "https://h0me-p0wer.lucianhanga.stream/api/watch/status";

    // Sent as "Authorization: Bearer <token>" when non-empty (see
    // HomePowerService.refresh) — matches the backend's optional API
    // token auth (h0me-p0wer repo, server/auth.js/generate-token.js).
    // Lives in Secrets.mc (gitignored — copy Secrets.mc.example to create
    // it) rather than here, so a real token never lands in git. Set it to
    // the SAME value generated by `npm run token:generate`. Expires after
    // 4 weeks — renewal is manual: regenerate, update Secrets.mc, rebuild,
    // reinstall.
    const API_TOKEN = Secrets.API_TOKEN;

    const REFRESH_MS = 15000;

    // Consumers page 16-color fallback palette, assigned by list position
    // (cycled when there are more consumers than entries) because the watch
    // payload has no colorIdx.
    const CONSUMER_PALETTE = [
        0xDD5F5F, 0x5FDDDD, 0x9EDD5F, 0x9E5FDD,
        0xDDBE5F, 0x5F7FDD, 0x5FDD7F, 0xDD5FBE,
        0xDD8E5F, 0x5FAEDD, 0x6FDD5F, 0xCD5FDD,
        0xCDDD5F, 0x6F5FDD, 0x5FDDAE, 0xDD5F8E,
    ];
    // "Rest of home" segment - always this grey, never from the palette.
    const CONSUMER_REST_COLOR = 0x90A4AE;
}
